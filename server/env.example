GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Optional; these are the defaults.
BASE_URI=http://localhost:8080/api/v0
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tw_e2e
DATABASE_SYSTEM_USERNAME=tw_system
DATABASE_SYSTEM_PASSWORD=tw_system
DATABASE_TENANT_USERNAME=tw_tenant
DATABASE_TENANT_PASSWORD=tw_tenant

# Delete sessions without a user every 60 seconds once they are older than 900 seconds.
# Both values must be positive integers, in seconds.
SESSION_CLEANUP_INTERVAL_SECONDS=60
PENDING_SESSION_MAX_AGE_SECONDS=900
