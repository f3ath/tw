# Copy to .env in the repository root. Use unquoted Make-compatible KEY=value.
# Registry host[:port] or host[:port]/namespace, without http:// or https://.
REGISTRY=registry.example.com:5000
SERVER_IMAGE=tw-server
SERVER_IMAGE_TAG=dev-1
# One target platform; leave empty to use Docker's default.
SERVER_PLATFORM=linux/arm64

# Helm deployment. PostgreSQL and the OAuth Secret must already exist.
KUBE_CONTEXT=your-context
KUBE_NAMESPACE=tw
SERVER_RELEASE=api
# Local Helm values file, kept outside the repository.
SERVER_VALUES_FILE=$(HOME)/.config/tw/server-values.yaml

# Independent ingress release, in the same namespace as the server.
INGRESS_RELEASE=edge
INGRESS_VALUES_FILE=$(HOME)/.config/tw/ingress-values.yaml

# Independent web release. WEB_PLATFORM defaults to SERVER_PLATFORM.
WEB_IMAGE=tw-web
WEB_IMAGE_TAG=dev-1
WEB_RELEASE=web
WEB_VALUES_FILE=$(HOME)/.config/tw/web-values.yaml
